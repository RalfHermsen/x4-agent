<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="X4_Agent_Bridge"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

<!--
  Spike: proves the full round trip game -> pipe -> external process -> pipe -> game.

  The shape is taken from sn_mod_support_apis/md/time_api.xml and the
  Server_Reader section of documentation/Named_Pipes_API.md. Every action and
  property used here was verified against libraries/common.xsd, libraries/md.xsd
  and libraries/scriptproperties.xml of X4 9.00 rather than written from memory.

  The file name must be lowercase, or X4 ignores the file without a word.
-->

<cues>

  <!-- Register our Python module with the pipe host. Must be resent on every
       Reloaded, hence instantiate. -->
  <cue name="Register_Pipe_Server" instantiate="true">
    <conditions>
      <event_cue_signalled cue="md.Pipe_Server_Host.Reloaded" />
    </conditions>
    <actions>
      <signal_cue_instantly
        cue="md.Pipe_Server_Host.Register_Module"
        param="'extensions/x4_agent_bridge/python/bridge.py'"/>
    </actions>
  </cue>

  <!-- Load our Lua side. It handles what MD cannot: parsing a command string
       and setting station prices and trade wares, which only exist as Lua
       functions. Path uses dots, not slashes, and the file must not be packed
       into a cat. -->
  <cue name="Load_Lua" instantiate="true">
    <conditions>
      <event_ui_triggered screen="'Lua_Loader'" control="'Ready'" />
    </conditions>
    <actions>
      <raise_lua_event name="'Lua_Loader.Load'"
                       param="'extensions.x4_agent_bridge.ui.x4agent'"/>
    </actions>
  </cue>

  <!-- Say which build of the bridge is live.
       "/refreshmd" in the in-game chat window reloads MD scripts without
       restarting the game, which turns a five-minute restart into a keystroke.
       The catch is that a refresh looks exactly like no refresh: the game says
       nothing, and the next command behaves the same either way unless the
       change happens to be visible. So the bridge now announces itself, and
       "did my refresh take" is answerable by looking at the logbook.

       Bump BRIDGE_BUILD whenever this file changes in a way worth confirming. -->
  <cue name="Announce_Build" instantiate="true">
    <conditions>
      <event_ui_triggered screen="'Chat_Window_API'" control="'refreshmd'" />
    </conditions>
    <actions>
      <write_to_logbook category="general"
        text="'[x4-agent] bridge reloaded, build 2026-08-20.5 (expand + solid storage, fund build storage)'"/>
      <show_notification
        text="'[x4-agent] bridge build 2026-08-20.5'"/>
    </actions>
  </cue>

  <!-- Independent proof that the Lua file was actually required, separate from
       whether anything inside it ran. The Lua Loader raises this itself. -->
  <cue name="Lua_Loaded" instantiate="true">
    <conditions>
      <event_ui_triggered screen="'Lua_Loader'"
                          control="'Loaded extensions.x4_agent_bridge.ui.x4agent'" />
    </conditions>
    <actions>
      <write_to_logbook category="general"
        text="'[x4-agent lua] file loaded'"/>
    </actions>
  </cue>

  <!-- The Lua side has no way to report anything. DebugError only reaches a log
       file the game does not write unless it was launched for it, so a command
       that Lua rejected, or a game function that returned nothing, looked
       exactly like a command that worked. This turns that into a logbook entry,
       which the agent reads back out of the savegame like any other fact. -->
  <cue name="Lua_Log" instantiate="true">
    <conditions>
      <event_ui_triggered screen="'X4Agent'" control="'log'" />
    </conditions>
    <actions>
      <write_to_logbook category="general"
        text="'[x4-agent lua] %s'.[event.param3]"/>
    </actions>
  </cue>

  <!-- The documentation warns that a cue using Server_Reader must not be
       created alongside its own action libraries. Hence this dummy wrapper. -->
  <cue name="Server_Reader_Wrapper">
    <cues>
      <cue name="Server_Reader" ref="md.Pipe_Server_Lib.Server_Reader">
        <param name="Actions_On_Reload"  value="Actions_On_Reload"/>
        <param name="Actions_On_Connect" value="Actions_On_Connect"/>
        <param name="Actions_On_Read"    value="Actions_On_Read"/>
      </cue>
    </cues>
  </cue>

  <library name="Actions_On_Reload">
    <actions>
      <set_value name="$Pipe_Name" exact="'x4_agent'" />
      <!-- This starts the whole connection routine: ping until the host
           answers, then connect, then read. The example in the API
           documentation only signals $Start_Reading from Actions_On_Connect,
           which is circular: connect runs after a connection exists, and the
           connection only happens because of this signal. hotkey_api.xml does
           it here, on line 253, and that works. -->
      <signal_cue cue="$Start_Reading" />
    </actions>
  </library>

  <library name="Actions_On_Connect">
    <actions>
      <signal_cue cue="$Start_Reading" />
    </actions>
  </library>

  <!-- Return path. Recognised messages:
         'save'              -> ask the game to write an autosave
         'explore <IDCODE>'  -> vanilla Explore order
         'autotrade <IDCODE>'-> vanilla TradeRoutine order
       Anything else is ignored apart from a debug line.

       Note the shape of the command matching. The Mission Director has **no
       string manipulation at all**: no split, no substring, no startswith
       (checked against libraries/scriptproperties.xml). So a command string
       cannot be taken apart here. What does exist is string formatting and
       equality, so we invert it: build the expected command for each of our
       own ships and compare the whole string. Linear in fleet size, and it
       only uses primitives that actually exist. -->
  <library name="Actions_On_Read">
    <actions>
      <debug_text text="'[x4-agent] received: %s'.[event.param]" filter="general"/>

      <set_value name="$agent_handled" exact="0"/>

      <!-- 'save' asks the game to write an autosave. The agent reads its state
           from the savegame, so this is how it gets a fresh picture instead of
           planning on whatever was last written. Confirmation comes back
           through the On_Game_Saved cue below. -->
      <do_if value="event.param == 'save'">
        <trigger_autosave/>
        <set_value name="$agent_handled" exact="1"/>
      </do_if>

      <find_object name="$agent_ships"
                   class="[class.ship_xs, class.ship_s, class.ship_m, class.ship_l, class.ship_xl]"
                   owner="faction.player"
                   space="player.galaxy"
                   multiple="true"
                   recursive="true"/>

      <find_object name="$agent_stations"
                   class="class.station"
                   owner="faction.player"
                   space="player.galaxy"
                   multiple="true"
                   recursive="true"/>

      <!-- Operating budget. A manager without money cannot open purchase
           orders, and a station with a zero budget silently does nothing: the
           account element in the savegame does not even carry an amount.

           The level is a word rather than a number, because a number cannot be
           parsed out of the command string. The model picks how aggressive to
           be, the game does the arithmetic. Capped at the player's own money so
           this can never overcommit. -->
      <do_for_each name="$agent_station" in="$agent_stations">
        <!-- Fund the build storage.

             A station and its build storage have separate accounts. Measured on
             KYV-745: the station held 930,744 Cr with a min and a max, while its
             build storage XQL-000 read <account id="[0x10c]" own="1"/>, which by
             the rule that X4 omits zero attributes means empty. A planned build
             with an empty build storage buys no resources and simply waits, and
             nothing anywhere says why.

             Budget levels rather than an amount, for the same reason as
             set_budget: a number cannot be parsed out of the command string.
             transfer_money reports what actually moved, so the logbook says
             whether it worked instead of what was attempted. -->
        <set_value name="$agent_fund" exact="0"/>
        <do_if value="event.param == 'fund %s low'.[$agent_station.idcode]">
          <set_value name="$agent_fund" exact="player.money / 10"/>
        </do_if>
        <do_if value="event.param == 'fund %s mid'.[$agent_station.idcode]">
          <set_value name="$agent_fund" exact="player.money / 4"/>
        </do_if>
        <do_if value="event.param == 'fund %s high'.[$agent_station.idcode]">
          <set_value name="$agent_fund" exact="player.money / 2"/>
        </do_if>
        <do_if value="$agent_fund > 0">
          <set_value name="$agent_handled" exact="1"/>
          <do_if value="@$agent_station.buildstorage">
            <transfer_money from="faction.player" to="$agent_station.buildstorage"
                            amount="$agent_fund" result="$agent_moved"/>
            <write_to_logbook category="general"
              text="'[x4-agent] ORDER: %s build storage funded with %s Cr'.[$agent_station.idcode, $agent_moved / 1Cr]"/>
            <show_notification
              text="'[x4-agent] %s build funds %s Cr'.[$agent_station.idcode, $agent_moved / 1Cr]"/>
          </do_if>
          <do_else>
            <write_to_logbook category="general"
              text="'[x4-agent] %s has no build storage to fund'.[$agent_station.idcode]"/>
          </do_else>
        </do_if>

        <do_if value="event.param == 'budget %s low'.[$agent_station.idcode]">
          <set_value name="$agent_budget" exact="player.money / 10"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>
        <do_if value="event.param == 'budget %s mid'.[$agent_station.idcode]">
          <set_value name="$agent_budget" exact="player.money / 4"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>
        <do_if value="event.param == 'budget %s high'.[$agent_station.idcode]">
          <set_value name="$agent_budget" exact="player.money / 2"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <!-- Expand an existing station so it produces a ware itself.

             The chain is entirely the game's own: get_god_production_construction_plan
             hands back the prefab plan its factions use for that product,
             apply_construction_sequence appends it to a station that already
             exists ("The construction plan for the station can be empty"), and
             add_build_to_expand_station turns it into a build task on the
             station's own build storage. That is exactly what engineer.ai.xml
             does for NPC stations.

             The ware is matched from a short explicit list. A ware name cannot
             be parsed out of the command string, and there is no ware-by-name
             lookup available here, so each supported ware needs its own
             comparison. The list covers the early and mid game wares from
             guidelines.md; extending it is one line per ware. -->
        <!-- $agent_solidinput: does this ware eat a mined solid? ore, silicon and
             ice are all transport="solid" in libraries/wares.xml, and a station
             with no solid storage cannot take delivery of any of them. Water is
             not liquid in X4; liquid is only hydrogen, helium and methane. -->
        <set_value name="$agent_ware" exact="null"/>
        <set_value name="$agent_module" exact="null"/>
        <set_value name="$agent_solidinput" exact="false"/>
        <do_if value="event.param == 'expand %s energycells'.[$agent_station.idcode]">
          <set_value name="$agent_ware" exact="ware.energycells"/>
          <set_value name="$agent_module" exact="macro.prod_gen_energycells_macro"/>
        </do_if>
        <do_if value="event.param == 'expand %s water'.[$agent_station.idcode]">
          <set_value name="$agent_ware" exact="ware.water"/>
          <set_value name="$agent_module" exact="macro.prod_gen_water_macro"/>
          <set_value name="$agent_solidinput" exact="true"/>
        </do_if>
        <do_if value="event.param == 'expand %s refinedmetals'.[$agent_station.idcode]">
          <set_value name="$agent_ware" exact="ware.refinedmetals"/>
          <set_value name="$agent_module" exact="macro.prod_gen_refinedmetals_macro"/>
          <set_value name="$agent_solidinput" exact="true"/>
        </do_if>
        <do_if value="event.param == 'expand %s siliconwafers'.[$agent_station.idcode]">
          <set_value name="$agent_ware" exact="ware.siliconwafers"/>
          <set_value name="$agent_module" exact="macro.prod_gen_siliconwafers_macro"/>
          <set_value name="$agent_solidinput" exact="true"/>
        </do_if>

        <do_if value="@$agent_ware">
          <set_value name="$agent_handled" exact="1"/>
          <!-- Refuse to stack plans. The agent replans every few minutes and
               the situation that triggered the expansion (a shortage nobody
               supplies) stays true for as long as the build takes, so without
               this check it would append the same construction plan over and
               over. The game already knows: hasplannedconstruction is "true if
               there are plans to expand this object". -->
          <do_if value="$agent_station.hasplannedconstruction">
            <write_to_logbook category="general"
              text="'[x4-agent] %s already has an expansion planned, leaving it alone'.[$agent_station.idcode]"/>
          </do_if>
          <do_elseif value="@$agent_station.buildstorage">
            <!-- Build the sequence ourselves instead of asking for a prefab.
                 get_god_production_construction_plan reads libraries/god.xml,
                 where every production entry is owned by an NPC faction: there
                 is not one for faction.player, so it returned null for every
                 ware and the expansion silently never happened.

                 create_construction_sequence takes the module macros directly
                 and works out how to attach them, with `base` extending what
                 the station already has rather than replacing it. `immediate`
                 blocks the game while it computes, which is acceptable for one
                 module and is the only way to get the result inside this cue.

                 The connectors are the ones the player owns in this game. A
                 connector we have no blueprint for would produce a sequence
                 that cannot be built, and too few of them produce something
                 worse: with failsafe on, which is the default, the generator
                 gives up connecting and drops the module "in free space
                 without any connections". That is what happened on the first
                 real expansion, and it looks exactly like success from here.
                 struct_arg_base_02 is in the list because the station is
                 already built out of it.

                 failsafe="false" turns that into a plain failure, which the
                 branch below reports. A refused expansion is recoverable; a
                 module floating next to the station is manual work for the
                 player. -->
            <!-- A production module is not enough on its own. An ore refinery
                 on a station with no solid storage is a refinery nobody can
                 deliver ore to, and the build would look entirely successful.
                 So the storage the ware needs goes into the same sequence, but
                 only when the station has none at all: adding one on every
                 expansion would stack storage modules for ever. That does mean
                 an existing but undersized store is left alone, which the agent
                 cannot yet judge. -->
            <set_value name="$agent_macros" exact="[$agent_module]"/>
            <do_if value="$agent_solidinput and $agent_station.cargo.capacity.solid == 0">
              <append_to_list name="$agent_macros" exact="macro.storage_tel_m_solid_01_macro"/>
              <write_to_logbook category="general"
                text="'[x4-agent] %s has no solid storage, adding one to the plan'.[$agent_station.idcode]"/>
            </do_if>
            <create_construction_sequence station="$agent_station"
                                          macros="$agent_macros"
                                          connectors="[macro.struct_arg_base_02_macro,
                                                       macro.struct_gen_venturerbase_01_macro,
                                                       macro.struct_gen_venturerbase_02_macro,
                                                       macro.struct_gen_venturerbase_03_macro,
                                                       macro.struct_gen_venturercross_01_macro,
                                                       macro.struct_gen_venturervertical_01_macro,
                                                       macro.struct_gen_venturervertical_02_macro]"
                                          failsafe="false"
                                          base="$agent_station.constructionsequence">
              <immediate result="$agent_plan"/>
            </create_construction_sequence>
            <do_if value="@$agent_plan">
              <apply_construction_sequence station="$agent_station" sequence="$agent_plan"/>
              <add_build_to_expand_station object="$agent_station.buildstorage"
                                           buildobject="$agent_station"
                                           constructionplan="$agent_station.plannedconstruction.sequence"/>
              <write_to_logbook category="general"
                text="'[x4-agent] ORDER: %s expanding to produce %s'.[$agent_station.idcode, $agent_ware.name]"/>
              <show_notification
                text="'[x4-agent] %s building %s production'.[$agent_station.idcode, $agent_ware.name]"/>
            </do_if>
            <do_else>
              <write_to_logbook category="general"
                text="'[x4-agent] could not build a construction sequence for %s'.[$agent_ware.name]"/>
            </do_else>
          </do_elseif>
          <do_else>
            <write_to_logbook category="general"
              text="'[x4-agent] %s has no build storage, cannot expand'.[$agent_station.idcode]"/>
          </do_else>
        </do_if>

        <do_if value="@$agent_budget and $agent_budget > 0">
          <set_object_min_budget object="$agent_station" amount="$agent_budget"/>
          <set_object_max_budget object="$agent_station" amount="$agent_budget * 3 / 2"/>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: budget of %s set to %s Cr'.[$agent_station.idcode, $agent_budget / 1Cr]"/>
          <show_notification
            text="'[x4-agent] %s budget %s Cr'.[$agent_station.idcode, $agent_budget / 1Cr]"/>
          <set_value name="$agent_budget" exact="0"/>
        </do_if>
      </do_for_each>

      <do_for_each name="$agent_ship" in="$agent_ships">
        <!-- Vanilla explore order; id verified in
             aiscripts/order.move.recon.explore.xml -->
        <do_if value="event.param == 'explore %s'.[$agent_ship.idcode]">
          <!-- Explore needs a target. Every <location> branch in
               aiscripts/order.move.recon.explore.xml requires either
               $destination or $targetspace, so an order created without one has
               no area to explore and ends the instant it starts. That looks
               exactly like the command never arriving: the logbook line is
               written, and a minute later the ship carries no order at all.

               So pick a sector the player has not seen yet, within a few gate
               jumps. find_sector_in_range counts in jumps, and isknown says
               whether the player knows the sector. If everything nearby is
               already known, fall back to the ship's own sector: a sweep there
               still turns up lockboxes, abandoned ships and station trade
               offers.

               default="true" makes it the ship's default behaviour rather than
               a one-shot queue entry, which is what the guidelines ask for: an
               idle scout should go back to exploring by itself. -->
          <find_sector_in_range name="$agent_nearby" object="$agent_ship"
                                mindistance="0" maxdistance="3" multiple="true"/>
          <set_value name="$agent_target" exact="$agent_ship.sector"/>
          <set_value name="$agent_found" exact="0"/>
          <do_for_each name="$agent_sector" in="$agent_nearby">
            <do_if value="$agent_found == 0 and not $agent_sector.isknown">
              <set_value name="$agent_target" exact="$agent_sector"/>
              <set_value name="$agent_found" exact="1"/>
            </do_if>
          </do_for_each>

          <create_order object="$agent_ship" id="'Explore'" default="true">
            <param name="targetspace" value="$agent_target"/>
          </create_order>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: %s exploring %s'.[$agent_ship.idcode, $agent_target.knownname]"/>
          <!-- The ticker does not pause the game; opening the logbook does. -->
          <show_notification text="'[x4-agent] %s exploring %s'.[$agent_ship.idcode, $agent_target.knownname]"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <!-- Vanilla autotrade; id verified in aiscripts/order.trade.routine.xml.
             Its warebasket and range parameters keep their defaults, because a
             ware list cannot travel through the pipe: MD cannot parse strings.
             The executor refuses to send this command when the model asked for
             a specific whitelist, rather than quietly dropping it. -->
        <!-- Vanilla mining routine, the counterpart of TradeRoutine. Same
             reasoning: parameters keep their defaults because a ware list
             cannot travel through the pipe. -->
        <do_if value="event.param == 'automine %s'.[$agent_ship.idcode]">
          <create_order object="$agent_ship" id="'MiningRoutine'"/>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: %s put on mining'.[$agent_ship.idcode]"/>
          <show_notification text="'[x4-agent] %s mining'.[$agent_ship.idcode]"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <do_if value="event.param == 'autotrade %s'.[$agent_ship.idcode]">
          <create_order object="$agent_ship" id="'TradeRoutine'"/>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: %s put on autotrade'.[$agent_ship.idcode]"/>
          <!-- The ticker does not pause the game; opening the logbook does. -->
          <show_notification text="'[x4-agent] %s put on autotrade'.[$agent_ship.idcode]"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <!-- Attach a ship to one of our stations as its trader or miner, which
             is the "Trade for station" / "Mine for station" subordinate role.
             Assignment values verified in the assignmentexprlookup enumeration
             of libraries/common.xsd.

             This command carries two identifiers, so the string-matching trick
             needs a nested loop. Only our own stations are searched, so the
             product stays small.

             The commander check makes a repeat harmless: re-sending the same
             assignment changes nothing and writes no logbook line. -->
        <do_for_each name="$agent_station" in="$agent_stations">
          <do_if value="event.param == 'assign %s %s trade'.[$agent_ship.idcode, $agent_station.idcode]">
            <set_value name="$agent_handled" exact="1"/>
            <do_if value="@$agent_ship.commander != $agent_station">
              <set_object_commander object="$agent_ship" commander="$agent_station"
                                    assignment="assignment.trade"/>
              <write_to_logbook category="general"
                text="'[x4-agent] ORDER: %s now trades for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
              <!-- The ticker does not pause the game; opening the logbook does. -->
              <show_notification text="'[x4-agent] %s now trades for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
            </do_if>
          </do_if>

          <do_if value="event.param == 'assign %s %s mine'.[$agent_ship.idcode, $agent_station.idcode]">
            <set_value name="$agent_handled" exact="1"/>
            <do_if value="@$agent_ship.commander != $agent_station">
              <set_object_commander object="$agent_ship" commander="$agent_station"
                                    assignment="assignment.mining"/>
              <write_to_logbook category="general"
                text="'[x4-agent] ORDER: %s now mines for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
              <!-- The ticker does not pause the game; opening the logbook does. -->
              <show_notification text="'[x4-agent] %s now mines for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
            </do_if>
          </do_if>
        </do_for_each>
      </do_for_each>

      <!-- Anything MD did not recognise goes to the Lua side, which can take a
           string apart and reach functions MD does not have. This is why no new
           command needs a change here: only the ones MD itself must execute
           (orders, assignments, builds) live above. -->
      <do_if value="$agent_handled == 0">
        <raise_lua_event name="'X4Agent.Command'" param="event.param"/>
      </do_if>

      <!-- Deliberately no fallback logbook entry. The logbook is the player's
           record of what happened in the game, not a protocol trace: commands
           the agent sends and status chatter do not belong there. Only actual
           orders write a line, inside the branches above. Unrecognised messages
           go to the debug log via the debug_text at the top. -->
    </actions>
  </library>

  <!-- Outbound: a minimal state every 30 seconds. Deliberately small; the real
       sitrep only goes through once this loop is proven. Note that cues with a
       checkinterval do not fire while the game is paused. -->
  <cue name="Send_State" instantiate="true" checkinterval="30s">
    <actions>
      <signal_cue_instantly
        cue="md.Named_Pipes.Write"
        param="table[$pipe = 'x4_agent',
                     $msg  = 'state money=%s time=%s'.[player.money, player.age],
                     $cue  = Write_Callback]"/>
    </actions>
  </cue>

  <!-- Tell the agent a savegame has been written, so it can read fresh state.
       This fires for player saves too, which is useful: saving the game is a
       natural moment to replan. -->
  <cue name="On_Game_Saved" instantiate="true">
    <conditions>
      <event_game_saved/>
    </conditions>
    <actions>
      <signal_cue_instantly
        cue="md.Named_Pipes.Write"
        param="table[$pipe = 'x4_agent', $msg = 'saved']"/>
    </actions>
  </cue>

  <cue name="Write_Callback" instantiate="true">
    <conditions>
      <event_cue_signalled/>
    </conditions>
    <actions>
      <debug_text text="'[x4-agent] write result: %s'.[event.param]" filter="general"/>
    </actions>
  </cue>

</cues>

</mdscript>
