<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="X4_Agent_Bridge"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

<!--
  Spike: proves the full round trip game -> pipe -> external process -> pipe -> game.

  The shape is taken from sn_mod_support_apis/md/time_api.xml and the
  Server_Reader section of documentation/Named_Pipes_API.md. Every action and
  property used here was verified against libraries/common.xsd, libraries/md.xsd
  and libraries/scriptproperties.xml of X4 9.00 rather than written from memory.

  The file name must be lowercase, or X4 ignores the file without a word.
-->

<cues>

  <!-- Register our Python module with the pipe host. Must be resent on every
       Reloaded, hence instantiate. -->
  <cue name="Register_Pipe_Server" instantiate="true">
    <conditions>
      <event_cue_signalled cue="md.Pipe_Server_Host.Reloaded" />
    </conditions>
    <actions>
      <signal_cue_instantly
        cue="md.Pipe_Server_Host.Register_Module"
        param="'extensions/x4_agent_bridge/python/bridge.py'"/>
    </actions>
  </cue>

  <!-- The documentation warns that a cue using Server_Reader must not be
       created alongside its own action libraries. Hence this dummy wrapper. -->
  <cue name="Server_Reader_Wrapper">
    <cues>
      <cue name="Server_Reader" ref="md.Pipe_Server_Lib.Server_Reader">
        <param name="Actions_On_Reload"  value="Actions_On_Reload"/>
        <param name="Actions_On_Connect" value="Actions_On_Connect"/>
        <param name="Actions_On_Read"    value="Actions_On_Read"/>
      </cue>
    </cues>
  </cue>

  <library name="Actions_On_Reload">
    <actions>
      <set_value name="$Pipe_Name" exact="'x4_agent'" />
      <!-- This starts the whole connection routine: ping until the host
           answers, then connect, then read. The example in the API
           documentation only signals $Start_Reading from Actions_On_Connect,
           which is circular: connect runs after a connection exists, and the
           connection only happens because of this signal. hotkey_api.xml does
           it here, on line 253, and that works. -->
      <signal_cue cue="$Start_Reading" />
    </actions>
  </library>

  <library name="Actions_On_Connect">
    <actions>
      <signal_cue cue="$Start_Reading" />
    </actions>
  </library>

  <!-- Return path. Recognised messages:
         'save'              -> ask the game to write an autosave
         'explore <IDCODE>'  -> vanilla Explore order
         'autotrade <IDCODE>'-> vanilla TradeRoutine order
       Anything else is ignored apart from a debug line.

       Note the shape of the command matching. The Mission Director has **no
       string manipulation at all**: no split, no substring, no startswith
       (checked against libraries/scriptproperties.xml). So a command string
       cannot be taken apart here. What does exist is string formatting and
       equality, so we invert it: build the expected command for each of our
       own ships and compare the whole string. Linear in fleet size, and it
       only uses primitives that actually exist. -->
  <library name="Actions_On_Read">
    <actions>
      <debug_text text="'[x4-agent] received: %s'.[event.param]" filter="general"/>

      <set_value name="$agent_handled" exact="0"/>

      <!-- 'save' asks the game to write an autosave. The agent reads its state
           from the savegame, so this is how it gets a fresh picture instead of
           planning on whatever was last written. Confirmation comes back
           through the On_Game_Saved cue below. -->
      <do_if value="event.param == 'save'">
        <trigger_autosave/>
        <set_value name="$agent_handled" exact="1"/>
      </do_if>

      <find_object name="$agent_ships"
                   class="[class.ship_xs, class.ship_s, class.ship_m, class.ship_l, class.ship_xl]"
                   owner="faction.player"
                   space="player.galaxy"
                   multiple="true"
                   recursive="true"/>

      <find_object name="$agent_stations"
                   class="class.station"
                   owner="faction.player"
                   space="player.galaxy"
                   multiple="true"
                   recursive="true"/>

      <do_for_each name="$agent_ship" in="$agent_ships">
        <!-- Vanilla explore order; id verified in
             aiscripts/order.move.recon.explore.xml -->
        <do_if value="event.param == 'explore %s'.[$agent_ship.idcode]">
          <create_order object="$agent_ship" id="'Explore'"/>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: %s sent to explore'.[$agent_ship.idcode]"/>
          <!-- The ticker does not pause the game; opening the logbook does. -->
          <show_notification text="'[x4-agent] %s sent to explore'.[$agent_ship.idcode]"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <!-- Vanilla autotrade; id verified in aiscripts/order.trade.routine.xml.
             Its warebasket and range parameters keep their defaults, because a
             ware list cannot travel through the pipe: MD cannot parse strings.
             The executor refuses to send this command when the model asked for
             a specific whitelist, rather than quietly dropping it. -->
        <do_if value="event.param == 'autotrade %s'.[$agent_ship.idcode]">
          <create_order object="$agent_ship" id="'TradeRoutine'"/>
          <write_to_logbook category="general"
            text="'[x4-agent] ORDER: %s put on autotrade'.[$agent_ship.idcode]"/>
          <!-- The ticker does not pause the game; opening the logbook does. -->
          <show_notification text="'[x4-agent] %s put on autotrade'.[$agent_ship.idcode]"/>
          <set_value name="$agent_handled" exact="1"/>
        </do_if>

        <!-- Attach a ship to one of our stations as its trader or miner, which
             is the "Trade for station" / "Mine for station" subordinate role.
             Assignment values verified in the assignmentexprlookup enumeration
             of libraries/common.xsd.

             This command carries two identifiers, so the string-matching trick
             needs a nested loop. Only our own stations are searched, so the
             product stays small.

             The commander check makes a repeat harmless: re-sending the same
             assignment changes nothing and writes no logbook line. -->
        <do_for_each name="$agent_station" in="$agent_stations">
          <do_if value="event.param == 'assign %s %s trade'.[$agent_ship.idcode, $agent_station.idcode]">
            <set_value name="$agent_handled" exact="1"/>
            <do_if value="$agent_ship.commander != $agent_station">
              <set_object_commander object="$agent_ship" commander="$agent_station"
                                    assignment="assignment.trade"/>
              <write_to_logbook category="general"
                text="'[x4-agent] ORDER: %s now trades for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
              <!-- The ticker does not pause the game; opening the logbook does. -->
              <show_notification text="'[x4-agent] %s now trades for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
            </do_if>
          </do_if>

          <do_if value="event.param == 'assign %s %s mine'.[$agent_ship.idcode, $agent_station.idcode]">
            <set_value name="$agent_handled" exact="1"/>
            <do_if value="$agent_ship.commander != $agent_station">
              <set_object_commander object="$agent_ship" commander="$agent_station"
                                    assignment="assignment.mining"/>
              <write_to_logbook category="general"
                text="'[x4-agent] ORDER: %s now mines for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
              <!-- The ticker does not pause the game; opening the logbook does. -->
              <show_notification text="'[x4-agent] %s now mines for %s'.[$agent_ship.idcode, $agent_station.idcode]"/>
            </do_if>
          </do_if>
        </do_for_each>
      </do_for_each>

      <!-- Deliberately no fallback logbook entry. The logbook is the player's
           record of what happened in the game, not a protocol trace: commands
           the agent sends and status chatter do not belong there. Only actual
           orders write a line, inside the branches above. Unrecognised messages
           go to the debug log via the debug_text at the top. -->
    </actions>
  </library>

  <!-- Outbound: a minimal state every 30 seconds. Deliberately small; the real
       sitrep only goes through once this loop is proven. Note that cues with a
       checkinterval do not fire while the game is paused. -->
  <cue name="Send_State" instantiate="true" checkinterval="30s">
    <actions>
      <signal_cue_instantly
        cue="md.Named_Pipes.Write"
        param="table[$pipe = 'x4_agent',
                     $msg  = 'state money=%s time=%s'.[player.money, player.age],
                     $cue  = Write_Callback]"/>
    </actions>
  </cue>

  <!-- Tell the agent a savegame has been written, so it can read fresh state.
       This fires for player saves too, which is useful: saving the game is a
       natural moment to replan. -->
  <cue name="On_Game_Saved" instantiate="true">
    <conditions>
      <event_game_saved/>
    </conditions>
    <actions>
      <signal_cue_instantly
        cue="md.Named_Pipes.Write"
        param="table[$pipe = 'x4_agent', $msg = 'saved']"/>
    </actions>
  </cue>

  <cue name="Write_Callback" instantiate="true">
    <conditions>
      <event_cue_signalled/>
    </conditions>
    <actions>
      <debug_text text="'[x4-agent] write result: %s'.[event.param]" filter="general"/>
    </actions>
  </cue>

</cues>

</mdscript>
